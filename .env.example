NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon-key name is supported if the project does not provide a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, required only by the explicit fixture importer. Never add NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only Gemini wording service; local grounded responses work without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NEXT_PUBLIC_APP_URL=http://localhost:3000
